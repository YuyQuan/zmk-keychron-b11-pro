/*
 * Keychron B11 Pro ANSI, stock keymap. Read from the stock 1.0.0 firmware image (6 layers, 70 positions,
 * same bindings), not designed: this is what the keyboard does out of the box. Copy and edit to taste.
 *
 * Position order is the shield's reading order (see the overlay): 14 + 14 + 13 + 13 + 11 keys, then five
 * direct inputs in the last row: position 65 is the Mac/Win switch, 66-69 are the mode slider
 * (USB, 2.4G, BT) and the charge sense. Those five are inputs, not keys; their bindings are what the
 * stock firmware has.
 *
 * Two raw values: `&kp 0xc02a0` is the Mac Launchpad usage (AC Desktop Show All Applications; this tree names
 * 0x2a2 instead), and `&uc 0xf000` is a Keychron user key under fn+Win on the Windows layers (believed to be
 * the Win-key lock; not decoded further).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keychron.h>

/ {
    /* The three behaviors below exist so the Keychron Launcher's keycode mapping can find them. */
    macro1:zm_ma{
        compatible = "zmk,behavior-macro-one-param";
        #binding-cells = <1>;
        bindings=<&kp 0x770000>;
    };
    lm: layer_mod {
        compatible = "zmk,behavior-macro-two-param";
        wait-ms = <0>;
        tap-ms = <0>;
        #binding-cells = <2>;
        bindings
            = <&macro_param_1to1>
            , <&macro_press &mo 0>
            , <&macro_param_2to1>
            , <&macro_press &kp 0>
            , <&macro_pause_for_release>
            , <&macro_param_2to1>
            , <&macro_release &kp 0>
            , <&macro_param_1to1>
            , <&macro_release &mo 0>
            ;
    };
    td1:tapd_layer{
        compatible = "zmk,behavior-tap-dance1";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings =<&mo 0>,<&mo 0>,<&mo 0>,<&mo 0>,<&to 0>;
    };

    /* tap = send the Keychron command, hold 3 s = nothing (used by the fn combos below) */
    kc_lp:l1{
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&kc>,<&none>;
    };

    /* BT slots and 2.4G: hold 3 s = pair, tap = reconnect */
    ZMK_MACRO(bt_pair0, bindings = <&kc BT_PAIR 0>;)
    ZMK_MACRO(bt_pair1, bindings = <&kc BT_PAIR 1>;)
    ZMK_MACRO(bt_pair2, bindings = <&kc BT_PAIR 2>;)
    ZMK_MACRO(ppt_pair, bindings = <&kc PPT_PAIR 0>;)
    ZMK_MACRO(bt_recon_0, bindings = <&kc BT_SEL 0>;)
    ZMK_MACRO(bt_recon_1, bindings = <&kc BT_SEL 1>;)
    ZMK_MACRO(bt_recon_2, bindings = <&kc BT_SEL 2>;)
    ZMK_MACRO(ppt_recon, bindings = <&kc PPT_SEL 0>;)

    bt_pair_0: bt_pair_0 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair0>, <&bt_recon_0>;
    };
    bt_pair_1: bt_pair_1 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair1>, <&bt_recon_1>;
    };
    bt_pair_2: bt_pair_2 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair2>, <&bt_recon_2>;
    };
    ppt_pair_0: ppt_pair_0 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&ppt_pair>, <&ppt_recon>;
    };

    /* a plain key press that the Launcher shows as a Mac/Win-aware key (Opt/Cmd, Alt/Win) */
    uc:user_custom {
        compatible = "zmk,behavior-key-press";
        #binding-cells =<1>;
    };

    combos {
        compatible = "zmk,combos";

        /* Keychron system combos, active while fn (layer 1 on Mac, 4 on Windows) is held. */
        combo_jz {
            timeout-ms = <1000>;
            layers = <1 4>;
            key-positions = <35 42>; // fn+j+z : recover (factory reset)
            bindings = <&kc_lp RCV>;
        };
        combo_xl {
            timeout-ms = <1000>;
            layers = <1 4>;
            key-positions = <43 37>; // fn+x+l : F-row exchange
            bindings = <&kc_lp FN_EXG 0>;
        };
        combo_b {
            timeout-ms = <1000>;
            layers = <1 4>;
            key-positions = <46>; // fn+b : battery level
            bindings = <&kc BATINFO>;
        };

        /* Registration combos: they reference behaviors (to, tog, sl, lt, sk, mt, gresc) so the Launcher's
         * keycode mapping finds them. Position 120 never exists. */
        combo_t0 {
            timeout-ms = <10 >;
            layers =<4>;
            key-positions = <120>;
            bindings = <&to 3 >;
        };
        combo_t1 {
            timeout-ms = <10 >;
            layers =<4>;
            key-positions = <120>;
            bindings = <&tog 3 >;
        };
        combo_t2 {
            timeout-ms = <10 >;
            layers =<4>;
            key-positions = <120>;
            bindings = <&sl 3 >;
        };
        combo_t3 {
            timeout-ms = <10 >;
            layers =<4>;
            key-positions = <120>;
            bindings = <&lt 3 SPACE>;
        };
        combo_t4 {
            timeout-ms = <10 >;
            layers =<4>;
            key-positions = <120>;
            bindings = <&sk LSHIFT>;
        };
        combo_t5 {
            timeout-ms = <10 >;
            layers =<4>;
            key-positions = <120>;
            bindings = <&mt LSHIFT SPACE>;
        };
        combo_t6 {
            timeout-ms = <10 >;
            layers =<4>;
            key-positions = <120>;
            bindings = <&gresc>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        /* 0: Mac base (the Mac/Win switch, A26, holds layer 3 for Windows) */
        mac_base_layer {
            label = "mac_base";
            bindings = <
            &kp ESC    &kp N1       &kp N2       &kp N3       &kp N4      &kp N5     &kp N6    &kp N7  &kp N8     &kp N9    &kp N0     &kp MINUS  &kp EQUAL  &kp BSPC
            &kp TAB    &kp Q        &kp W        &kp E        &kp R       &kp T      &kp Y     &kp U   &kp I      &kp O     &kp P      &kp LBKT   &kp RBKT   &kp BSLH
            &kp CAPS   &kp A        &kp S        &kp D        &kp F       &kp G      &kp H     &kp J   &kp K      &kp L     &kp SEMI   &kp SQT    &kp RET
            &kp LSHFT  &kp Z        &kp X        &kp C        &kp V       &kp B      &kp N     &kp M   &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT  &kp UP
            &kp LCTRL  &mo 1        &uc LALT     &uc LGUI     &kp SPACE   &kp SPACE  &uc RGUI  &mo 2   &kp LEFT   &kp DOWN  &kp RIGHT
            &mo 3      &kc SEL_USB  &kc SEL_PPT  &kc SEL_BLE  &kc BATCHG
            >;
        };

        /* 1: Mac fn, left of space: media and system keys, BT / 2.4G pairing on the Q row */
        mac_fn_layer {
            label = "mac_fn";
            bindings = <
            &kp GRAVE  &kp C_BRI_DN    &kp C_BRI_UP    &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp 0xc02a0      &kp C_AC_SEARCH  &kp C_AL_LOCK  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp C_MUTE  &kp C_VOL_DN       &kp C_VOL_UP  &trans
            &trans     &bt_pair_0 0 0  &bt_pair_1 0 0  &bt_pair_2 0 0                     &ppt_pair_0 0 0  &trans           &trans         &trans      &kp INS   &trans      &trans      &trans             &trans        &uc LG(LS(N4))
            &trans     &trans          &trans          &trans                             &trans           &trans           &trans         &trans      &trans    &trans      &trans      &trans             &trans
            &trans     &trans          &trans          &trans                             &trans           &kc BATINFO      &trans         &trans      &trans    &trans      &trans      &uc LG(LC(SPACE))  &kp PG_UP
            &trans     &trans          &trans          &trans                             &trans           &trans           &kp RCTRL      &trans      &kp HOME  &kp PG_DN   &kp END
            &none      &trans          &trans          &trans                             &trans
            >;
        };

        /* 2: Mac fn2, right of space: F1-F12 on the number row */
        mac_fn2_layer {
            label = "mac_fn2";
            bindings = <
            &kp LS(GRAVE)  &kp F1          &kp F2          &kp F3          &kp F4           &kp F5       &kp F6     &kp F7  &kp F8    &kp F9     &kp F10  &kp F11            &kp F12    &trans
            &trans         &bt_pair_0 0 0  &bt_pair_1 0 0  &bt_pair_2 0 0  &ppt_pair_0 0 0  &trans       &trans     &trans  &kp INS   &trans     &trans   &trans             &trans     &uc LG(LS(N4))
            &trans         &trans          &trans          &trans          &trans           &trans       &trans     &trans  &trans    &trans     &trans   &trans             &trans
            &trans         &trans          &trans          &trans          &trans           &kc BATINFO  &trans     &trans  &trans    &trans     &trans   &uc LG(LC(SPACE))  &kp PG_UP
            &trans         &trans          &trans          &trans          &trans           &trans       &kp RCTRL  &trans  &kp HOME  &kp PG_DN  &kp END
            &none          &trans          &trans          &trans          &trans
            >;
        };

        /* 3: Windows base, held by the Mac/Win switch: Win and Alt swapped to PC order */
        win_base_layer {
            label = "win_base";
            bindings = <
            &kp ESC    &kp N1       &kp N2       &kp N3       &kp N4      &kp N5     &kp N6    &kp N7  &kp N8     &kp N9    &kp N0     &kp MINUS  &kp EQUAL  &kp BSPC
            &kp TAB    &kp Q        &kp W        &kp E        &kp R       &kp T      &kp Y     &kp U   &kp I      &kp O     &kp P      &kp LBKT   &kp RBKT   &kp BSLH
            &kp CAPS   &kp A        &kp S        &kp D        &kp F       &kp G      &kp H     &kp J   &kp K      &kp L     &kp SEMI   &kp SQT    &kp RET
            &kp LSHFT  &kp Z        &kp X        &kp C        &kp V       &kp B      &kp N     &kp M   &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT  &kp UP
            &kp LCTRL  &mo 4        &kp LGUI     &kp LALT     &kp SPACE   &kp SPACE  &kp RALT  &mo 5   &kp LEFT   &kp DOWN  &kp RIGHT
            &none      &kc SEL_USB  &kc SEL_PPT  &kc SEL_BLE  &kc BATCHG
            >;
        };

        /* 4: Windows fn, left of space: F1-F12 on the number row */
        win_fn_layer {
            label = "win_fn";
            bindings = <
            &kp GRAVE  &kp F1          &kp F2          &kp F3          &kp F4           &kp F5       &kp F6     &kp F7  &kp F8    &kp F9     &kp F10  &kp F11      &kp F12    &trans
            &trans     &bt_pair_0 0 0  &bt_pair_1 0 0  &bt_pair_2 0 0  &ppt_pair_0 0 0  &trans       &trans     &trans  &kp INS   &trans     &trans   &trans       &trans     &kp PSCRN
            &trans     &trans          &trans          &trans          &trans           &trans       &trans     &trans  &trans    &trans     &trans   &trans       &trans
            &trans     &trans          &trans          &trans          &trans           &kc BATINFO  &trans     &trans  &trans    &trans     &trans   &uc LG(DOT)  &kp PG_UP
            &trans     &trans          &uc 0xf000      &trans          &trans           &trans       &kp RCTRL  &trans  &kp HOME  &kp PG_DN  &kp END
            &none      &trans          &trans          &trans          &trans
            >;
        };

        /* 5: Windows fn2, right of space: media and system keys */
        win_fn2_layer {
            label = "win_fn2";
            bindings = <
            &kp LS(GRAVE)  &kp C_BRI_DN    &kp C_BRI_UP    &uc LG(TAB)     &uc LG(E)        &kp C_AC_SEARCH  &uc LG(L)  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans
            &trans         &bt_pair_0 0 0  &bt_pair_1 0 0  &bt_pair_2 0 0  &ppt_pair_0 0 0  &trans           &trans     &trans      &kp INS   &trans      &trans      &trans        &trans        &kp PSCRN
            &trans         &trans          &trans          &trans          &trans           &trans           &trans     &trans      &trans    &trans      &trans      &trans        &trans
            &trans         &trans          &trans          &trans          &trans           &kc BATINFO      &trans     &trans      &trans    &trans      &trans      &uc LG(DOT)   &kp PG_UP
            &trans         &trans          &uc 0xf000      &trans          &trans           &trans           &kp RCTRL  &trans      &kp HOME  &kp PG_DN   &kp END
            &none          &trans          &trans          &trans          &trans
            >;
        };
    };
};
&mt {
    tapping-term-ms = <400>;
};
/* no encoder on the B11 Pro: the K3 SE2 &inc_dec_kp override is dropped (it pulls in the sensor-rotate code) */
